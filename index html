<style>

/* ===== TOKENS (matches wallet / TaskPro / StatusPay exactly) ===== */
:root{
  --bg:#0d0f14;
  --accent-1:#a78bfa;
  --accent-2:#f472b6;
  --green:#22c55e;
  --dim:#8b90a0;
  --dim2:#4a4f5c;
  --border:rgba(255,255,255,0.08);
}

*{ box-sizing:border-box; }

body{
  margin:0; padding:0; min-height:100vh;
  background: var(--bg);
  background-image: radial-gradient(circle at 50% 50%, rgba(112, 0, 255, 0.15), transparent), url('https://www.transparenttextures.com/patterns/carbon-fibre.png');
  color:#fff;
  font-family:'Quicksand', sans-serif;
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
}

.display{ font-family:'Quicksand', sans-serif; }
.eyebrow{ font-family:'Quicksand', sans-serif; font-weight:700; text-transform:uppercase; letter-spacing:3px; }
h1,h2,h3,h4{ font-family:'Quicksand', sans-serif; }

::selection{ background: rgba(167,139,250,0.3); }

/* ===== SCROLL REVEAL ===== */
.reveal{ opacity:0; transform:translateY(36px); transition: opacity .7s cubic-bezier(.16,1,.3,1), transform .7s cubic-bezier(.16,1,.3,1); }
.reveal.visible{ opacity:1; transform:translateY(0); }
@media (prefers-reduced-motion: reduce){ .reveal{ opacity:1; transform:none; transition:none; } }

/* ===== NAV ===== */
.header-nav{
  width:100%; max-width:1180px; margin:18px auto 0; padding:0 20px;
  display:flex; justify-content:space-between; align-items:center;
  position:relative; z-index:100; box-sizing:border-box;
}
.nav-logo{ font-family:'Quicksand', sans-serif; font-weight:700; font-size:22px; letter-spacing:-0.5px; }
.menu-icon{ width:28px; height:18px; display:flex; flex-direction:column; justify-content:space-between; cursor:pointer; z-index:1001; }
.menu-bar{ width:100%; height:2px; background:#fff; border-radius:2px; transition:.3s; }
.menu-bar.short{ width:60%; align-self:flex-end; }

#side-menu{
  position:fixed; top:64px; right:15px; width:180px;
  background:rgba(13,15,20,0.98); backdrop-filter:blur(24px); -webkit-backdrop-filter:blur(24px);
  border:1px solid var(--border); border-top:1px solid rgba(167,139,250,0.3); border-radius:14px; z-index:1000;
  display:none; flex-direction:column; padding:8px 0;
  box-shadow:0 20px 50px rgba(0,0,0,0.9);
}
#side-menu.active{ display:flex !important; }
.menu-link{
  padding:13px 16px; font-size:11px; font-weight:600; color:#fff; text-decoration:none;
  text-transform:uppercase; letter-spacing:1.2px; border-bottom:1px solid rgba(255,255,255,0.04);
}
.menu-link:last-child{ border-bottom:none; }
.menu-link.cta-link{ color:var(--accent-1); }

/* ===== HERO ===== */
.hero-wrap{ width:100%; max-width:800px; margin:0 auto; padding:60px 20px 0; text-align:center; box-sizing:border-box; }
.hero-eyebrow{ font-size:10px; color:var(--accent-1); margin-bottom:18px; opacity:0.9; }
.hero-h1{
  font-family:'Quicksand', sans-serif;
  font-size:clamp(2.1rem, 8vw, 3.4rem); font-weight:700;
  letter-spacing:-0.02em; line-height:1.12; margin:0;
}
.hero-h1 .grad{
  background:linear-gradient(135deg, var(--accent-1), var(--accent-2));
  -webkit-background-clip:text; background-clip:text; color:transparent;
}
.hero-p{ font-size:14.5px; color:#a3a8b3; max-width:420px; margin:18px auto 0; line-height:1.7; font-weight:400; }

.hero-ctas{ display:flex; gap:12px; justify-content:center; margin-top:32px; flex-wrap:wrap; }
.btn-primary{
  font-size:13px; font-weight:700; letter-spacing:.3px;
  padding:16px 28px; border-radius:14px; text-decoration:none;
  background:linear-gradient(135deg, var(--accent-1), var(--accent-2)); color:#0d0f14;
  box-shadow:0 10px 35px rgba(167,139,250,0.25);
  transition:.25s ease;
}
.btn-primary:hover{ transform:translateY(-2px); box-shadow:0 14px 40px rgba(167,139,250,0.35); }
.btn-secondary{
  font-size:13px; font-weight:700; letter-spacing:.3px;
  padding:16px 28px; border-radius:14px; text-decoration:none; color:#fff;
  background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.14);
  transition:.25s ease;
}
.btn-secondary:hover{ border-color:var(--accent-1); color:var(--accent-1); }

/* ===== LIVE WALLET DEMO ===== */
.wallet-demo{
  max-width:340px; margin:52px auto 0; padding:26px 24px;
  background:rgba(245,245,247,0.03); backdrop-filter:blur(26px) saturate(160%);
  border:1px solid rgba(255,255,255,0.08); border-top:1px solid rgba(167,139,250,0.35);
  border-radius:22px; position:relative; overflow:hidden;
}
.wallet-demo::before{
  content:''; position:absolute; top:-40%; left:-20%; width:140%; height:140%;
  background:radial-gradient(circle, rgba(167,139,250,0.08), transparent 60%); pointer-events:none;
}
.wallet-demo-label{ font-size:9px; color:var(--dim); text-transform:uppercase; letter-spacing:2px; text-align:left; font-weight:600; }
.wallet-demo-balance{ font-family:'Quicksand', sans-serif; font-size:34px; font-weight:700; text-align:left; margin-top:6px; transition:transform .2s ease; }
.wallet-demo-balance span{ font-size:16px; color:var(--dim); font-weight:500; }
.wallet-demo-tick{ font-size:11px; color:var(--green); text-align:left; margin-top:6px; font-weight:600; display:flex; align-items:center; gap:6px; }
.tick-dot{ width:6px; height:6px; border-radius:50%; background:var(--green); box-shadow:0 0 8px var(--green); animation:blink 1.4s infinite; }
@keyframes blink{ 0%,100%{opacity:1;} 50%{opacity:.3;} }
.wallet-demo-note{ font-size:9.5px; color:var(--dim2); text-align:left; margin-top:14px; line-height:1.5; }

/* ===== SECTIONS ===== */
.content-section{ width:100%; max-width:800px; margin:0 auto; padding:20px; box-sizing:border-box; }
.section-eyebrow{ font-size:10px; color:var(--accent-1); letter-spacing:3px; text-transform:uppercase; margin-bottom:8px; text-align:center; opacity:0.85; font-weight:700; }
.section-title{ font-family:'Quicksand', sans-serif; font-weight:700; font-size:22px; text-align:center; margin:0 0 30px; }

/* Flagship products (StatusPay / TaskPro) */
.product-block{
  background:rgba(255,255,255,0.025); border:1px solid var(--border); border-radius:22px;
  padding:26px 22px; margin-bottom:20px; position:relative; overflow:hidden;
}
.product-block.customers{ border-top:2px solid var(--accent-2); }
.product-block.subscribers{ border-top:2px solid var(--accent-1); }
.product-dot-row{ display:flex; align-items:center; gap:9px; margin-bottom:6px; }
.product-dot{ width:11px; height:11px; border-radius:50%; background:#fbbf24; flex-shrink:0; box-shadow:0 0 8px rgba(251,191,36,0.5); }
.product-name{ font-weight:700; font-size:15px; letter-spacing:-0.3px; }
.product-audience{ font-size:9.5px; color:var(--dim); text-transform:uppercase; letter-spacing:1.5px; font-weight:700; margin-bottom:10px; }
.product-headline{ font-size:19px; font-weight:700; margin:0 0 10px; line-height:1.3; }
.product-block p.product-copy{ font-size:12px; color:var(--dim); line-height:1.65; margin:0 0 16px; }
.product-bullets{ list-style:none; padding:0; margin:0 0 18px; }
.product-bullets li{ font-size:11.5px; color:#c9cdd4; margin-bottom:8px; padding-left:20px; position:relative; line-height:1.5; }
.product-bullets li::before{ content:'✓'; position:absolute; left:0; font-weight:700; }
.product-block.customers .product-bullets li::before{ color:var(--accent-2); }
.product-block.subscribers .product-bullets li::before{ color:var(--accent-1); }
.product-cta{ display:inline-block; font-size:11px; font-weight:700; letter-spacing:.3px; text-decoration:none; padding:12px 22px; border-radius:12px; }
.product-block.customers .product-cta{ background:linear-gradient(135deg, var(--accent-2), #fbbf24); color:#0d0f14; }
.product-block.subscribers .product-cta{ background:linear-gradient(135deg, var(--accent-1), var(--accent-2)); color:#0d0f14; }


.path-grid{ display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:44px; }
.path-card{
  background:rgba(255,255,255,0.025); border:1px solid var(--border); border-radius:20px;
  padding:22px 18px; position:relative; overflow:hidden;
}
.path-card.worker{ border-top:2px solid var(--accent-1); }
.path-card.advertiser{ border-top:2px solid var(--accent-2); }
.path-icon{ font-size:22px; margin-bottom:10px; }
.path-card h3{ font-family:'Quicksand', sans-serif; font-size:14px; font-weight:700; margin:0 0 8px; }
.path-card p{ font-size:11.5px; color:var(--dim); line-height:1.6; margin:0 0 14px; }
.path-list{ list-style:none; padding:0; margin:0 0 16px; }
.path-list li{ font-size:11px; color:#c9cdd4; margin-bottom:7px; padding-left:16px; position:relative; }
.path-list li::before{ content:'—'; position:absolute; left:0; color:var(--dim2); }
.path-card .path-cta{ font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:1px; text-decoration:none; }
.path-card.worker .path-cta{ color:var(--accent-1); }
.path-card.advertiser .path-cta{ color:var(--accent-2); }

/* How it works */
.workflow-list{ display:grid; grid-template-columns:1fr; gap:13px; margin-bottom:44px; }
.work-step{ display:flex; align-items:flex-start; gap:18px; background:rgba(255,255,255,0.025); border-left:2px solid var(--accent-1); padding:16px 18px; border-radius:0 14px 14px 0; }
.step-num{ font-family:'Quicksand', sans-serif; font-size:17px; font-weight:700; color:rgba(167,139,250,0.4); }
.step-text h4{ font-size:12px; color:#fff; margin:0 0 4px; font-weight:700; }
.step-text p{ font-size:11.5px; color:var(--dim); margin:0; line-height:1.55; }

/* Fee transparency band */
.fee-band{
  background:linear-gradient(135deg, rgba(244,114,182,0.06), rgba(167,139,250,0.04));
  border:1px solid var(--border); border-radius:20px; padding:24px 20px; margin-bottom:44px;
  text-align:center;
}
.fee-band .fee-eyebrow{ font-size:9px; color:var(--accent-2); letter-spacing:2px; text-transform:uppercase; margin-bottom:10px; font-weight:700; }
.fee-band .fee-big{ font-family:'Quicksand', sans-serif; font-size:30px; font-weight:700; }
.fee-band .fee-big span{ color:var(--accent-2); }
.fee-band p{ font-size:11.5px; color:var(--dim); max-width:420px; margin:10px auto 0; line-height:1.6; }
.fee-links{ margin-top:14px; display:flex; gap:20px; justify-content:center; flex-wrap:wrap; }
.fee-links span{ font-size:10px; color:#c9cdd4; }
.fee-links b{ color:var(--green); }

/* Referral */
.referral-box{
  background:rgba(255,255,255,0.025); border:1px solid rgba(167,139,250,0.18); border-radius:20px;
  padding:24px 20px; margin-bottom:44px;
}
.referral-box .r-eyebrow{ font-size:9px; color:var(--accent-1); letter-spacing:2px; text-transform:uppercase; margin-bottom:10px; font-weight:700; }
.referral-box h3{ font-family:'Quicksand', sans-serif; font-size:16px; font-weight:700; margin:0 0 10px; }
.referral-box p{ font-size:11.5px; color:var(--dim); line-height:1.6; margin:0 0 16px; }
.referral-tiers{ display:flex; gap:12px; }
.referral-tier{ flex:1; background:rgba(167,139,250,0.06); border:1px solid rgba(167,139,250,0.18); border-radius:14px; padding:14px; text-align:center; }
.referral-tier .rt-pct{ font-family:'Quicksand', sans-serif; font-size:20px; font-weight:700; color:var(--accent-1); }
.referral-tier .rt-label{ font-size:9px; color:var(--dim); text-transform:uppercase; letter-spacing:1px; margin-top:4px; }

/* Trust */
.trust-box{ background:rgba(255,255,255,0.025); border:1px solid var(--border); border-radius:20px; padding:24px 20px; margin-bottom:44px; }
.trust-grid{ display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-top:16px; }
.trust-item h4{ font-size:11px; color:#fff; margin:0 0 8px; display:flex; align-items:center; gap:8px; font-weight:700; }
.trust-item p{ font-size:11px; color:var(--dim); line-height:1.6; margin:0; }

/* Principles */
.principle-container{ width:100%; overflow:hidden; position:relative; margin-bottom:44px; padding:24px 22px; background:rgba(255,255,255,0.015); border-radius:20px; border:1px dashed rgba(255,255,255,0.1); text-align:center; }
.principle-slide{ display:none; animation:fadeIn .5s ease-in; }
.principle-slide.active{ display:block; }
.principle-text{ font-style:italic; font-size:15px; color:#ccc; margin-bottom:12px; line-height:1.6; font-weight:400; }
.principle-tag{ color:var(--accent-1); font-size:10px; font-weight:700; letter-spacing:2px; }
@keyframes fadeIn{ from{opacity:0;} to{opacity:1;} }

/* FAQ */
.faq-item{ background:rgba(255,255,255,0.03); border:1px solid var(--border); border-radius:14px; margin-bottom:10px; overflow:hidden; }
.faq-header{ padding:16px; cursor:pointer; display:flex; justify-content:space-between; align-items:center; font-size:12px; font-weight:700; }
.faq-body{ padding:0 16px; max-height:0; overflow:hidden; transition:.3s ease-out; font-size:11.5px; color:var(--dim); line-height:1.65; }
.faq-item.active .faq-body{ padding:8px 16px 16px; max-height:220px; }
.faq-item.active .faq-header{ color:var(--accent-1); }

/* Final CTA */
.final-cta{ text-align:center; padding:36px 20px 44px; }
.final-cta h2{ font-family:'Quicksand', sans-serif; font-weight:700; font-size:22px; margin:0 0 10px; }
.final-cta p{ font-size:12px; color:var(--dim); margin:0 0 24px; }

/* Footer */
.footer-minimal{ width:100%; max-width:800px; margin:20px auto 0; padding:36px 20px; border-top:1px solid var(--border); text-align:center; box-sizing:border-box; }
.footer-logo{ font-family:'Quicksand', sans-serif; font-size:17px; font-weight:700; margin-bottom:15px; opacity:.8; }
.footer-legal-links{ display:flex; justify-content:center; gap:18px; margin-bottom:22px; flex-wrap:wrap; }
.legal-link{ font-size:10px; color:#666; text-decoration:none; text-transform:uppercase; letter-spacing:1px; transition:.3s; }
.legal-link:hover{ color:var(--accent-1); }
.footer-disclaimer{ font-size:9px; color:#4a4f5c; line-height:1.6; max-width:600px; margin:0 auto 22px; }
.footer-copyright{ font-size:9px; color:#555; letter-spacing:2px; font-weight:600; }

@media (max-width:600px){
  .path-grid, .trust-grid{ grid-template-columns:1fr; }
  .referral-tiers{ flex-direction:column; }
  .footer-legal-links{ gap:10px; }
}
</style>
</head>
