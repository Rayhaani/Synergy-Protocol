<script>
  const menuBtn = document.getElementById('menuBtn');
  const sideMenu = document.getElementById('side-menu');
  menuBtn.onclick = (e) => { sideMenu.classList.toggle('active'); e.stopPropagation(); }
  document.onclick = (e) => { if (!sideMenu.contains(e.target) && e.target !== menuBtn) { sideMenu.classList.remove('active'); } }

  function toggleFaq(header) {
    header.parentElement.classList.toggle('active');
    const icon = header.querySelector('span');
    icon.innerText = header.parentElement.classList.contains('active') ? '−' : '+';
  }

  let currentPrinciple = 0;
  const principles = document.querySelectorAll('.principle-slide');
  setInterval(() => {
    principles[currentPrinciple].classList.remove('active');
    currentPrinciple = (currentPrinciple + 1) % principles.length;
    principles[currentPrinciple].classList.add('active');
  }, 4500);

  /* Illustrative wallet-demo ticker — purely decorative, not a real balance */
  let demoBalance = 12450;
  const demoEl = document.getElementById('demoBalance');
  setInterval(() => {
    demoBalance += Math.floor(Math.random() * 40) + 10;
    demoEl.textContent = demoBalance.toLocaleString('en-NG');
    demoEl.parentElement.style.transform = 'scale(1.03)';
    setTimeout(() => { demoEl.parentElement.style.transform = 'scale(1)'; }, 200);
  }, 3200);

  /* Scroll-triggered reveal, staggered within each group */
  const revealEls = document.querySelectorAll('.reveal');

  const io = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const siblings = Array.from(entry.target.parentElement.children).filter(c => c.classList.contains('reveal'));
        const idx = siblings.indexOf(entry.target);
        entry.target.style.transitionDelay = (idx * 90) + 'ms';
        entry.target.classList.add('visible');
        io.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

  revealEls.forEach(el => io.observe(el));
</script>

